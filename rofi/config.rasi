/*
 * ROFI THEME - ARCH LINUX / HYPRLAND
 * Mode: Pure Monochrome (Dark / Light)
 */

configuration {
    show-icons:     false;
    icon-theme:     "Papirus-Dark";
    font:           "JetBrainsMono Nerd Font 11";
    display-drun:       " Apps";
    display-run:        " Run";
    display-clipboard:  "󰅌 Clip";
    kb-cancel:              "Escape";
    kb-remove-char-back:    "BackSpace,Shift+BackSpace";
    kb-accept-entry:        "Return,KP_Enter";
    kb-custom-1:            "Alt+u";
    kb-custom-2:            "Alt+y";
    kb-custom-3:            "Alt+t";
    me-select-entry:        "";
    me-accept-entry:        "MousePrimary";
    sort:                   true;
    sorting-method:         "fzf";
    matching:               "fuzzy";
    drun-match-fields:      "name,generic,exec,keywords";
    scroll-method:          0;
    click-to-exit:          true;
    run-command:            "{cmd}";
    run-shell-command:      "{terminal} -e {cmd}";
    drun-use-gio:           false;
    drun-display-format:    "{name}";
}

/* --- Import Colors --- */
@import "theme.rasi"

* {
    var-win-bg:           @surface-dim;
    var-input-bg:         @surface-container-high;
    var-urgent-bg:        @error-container;
    var-active-bg:        @primary;
    var-message-bg:       @surface-container;
    var-text-def:         @on-surface;
    var-text-dim:         @on-surface-variant;
    var-text-urgent:      @on-error-container;
    var-text-active:      @on-primary;
    var-border:           @primary;
    
    background-color:     @var-win-bg;
    text-color:           @var-text-def;
    border-color:         @var-border;
    normal-background:            transparent;
    normal-foreground:            @var-text-def;
    alternate-normal-background:  transparent;
    alternate-normal-foreground:  @var-text-def;
    selected-normal-background:   @var-active-bg;
    selected-normal-foreground:   @var-text-active;
    active-background:            @var-active-bg;
    active-foreground:            @var-text-active;
    urgent-background:            @var-urgent-bg;
    urgent-foreground:            @var-text-urgent;
    selected-urgent-background:   @var-urgent-bg;
    selected-urgent-foreground:   @var-text-urgent;
}

window {
    location:           center;
    anchor:             center;
    width:              25%;
    background-color:   @var-win-bg;
    border:             1px;
    border-color:       @surface-container-high;
    border-radius:      0px;
    padding:            20px;
}

mainbox {
    children:           [ inputbar, message, listview ];
    spacing:            15px;
    background-color:   transparent;
    border:             0;
    padding:            0;
}

inputbar {
    children:           [ prompt, entry ];
    spacing:            10px;
    padding:            12px;
    background-color:   transparent;
    text-color:         @var-text-def;
}

prompt {
    enabled:            true;
    background-color:   transparent;
    text-color:         @var-text-dim;
    font:               "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder:        "Search...";
    placeholder-color:  @var-text-dim;
    background-color:   transparent;
    text-color:         @var-text-def;
    cursor:             text;
}

message {
    background-color:   transparent;
    border:             0;
    padding:            0;
}

textbox {
    background-color:   transparent;
    text-color:         @var-text-dim;
    padding:            8px 12px;
    border-radius:      0;
    markup:             true;
    font:               "JetBrainsMono Nerd Font 9";
    horizontal-align:   0.5;
}

listview {
    columns:            1;
    lines:              8;
    cycle:              true;
    scrollbar:          false;
    spacing:            8px;
    fixed-height:       false;
    background-color:   transparent;
    border:             0;
    border-radius:      0;
    padding:            0;
}

element {
    padding:            8px 12px;
    border-radius:      0;
    cursor:             pointer;
    spacing:            6px;
    border:             0;
}

element-icon {
    enabled:            false;
}

element-text {
    vertical-align:     0.5;
    background-color:   transparent;
    text-color:         inherit;
    highlight:          bold underline;
    cursor:             inherit;
    horizontal-align:   0;
}

element normal.normal {
    background-color: @normal-background;
    text-color:       @normal-foreground;
}
element alternate.normal {
    background-color: @alternate-normal-background;
    text-color:       @alternate-normal-foreground;
}
element selected.normal {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}
element selected.active {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}
element selected.urgent {
    background-color: @selected-urgent-background;
    text-color:       @selected-urgent-foreground;
}
element normal.active {
    background-color: @active-background;
    text-color:       @active-foreground;
}
element alternate.active {
    background-color: @active-background;
    text-color:       @active-foreground;
}
element normal.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}
element alternate.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}
