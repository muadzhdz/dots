#!/usr/bin/env python3
import sys, os, time, socket, select, math, struct, subprocess

RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
VOXTYPE_DIR = os.path.join(RUNTIME_DIR, "voxtype")
SOCKET_PATH = os.path.join(VOXTYPE_DIR, "audio.sock")
STATE_PATH = os.path.join(VOXTYPE_DIR, "state")

BARS = [" ", " ", "▂", "▃", "▄", "▅", "▆", "▇", "█"]

def get_state():
    if os.path.exists(STATE_PATH):
        try:
            with open(STATE_PATH, "r") as f:
                return f.read().strip()
        except Exception:
            pass
    return "unknown"

def render_meter(rms, peak, width=24):
    db = 20 * math.log10(max(rms, 1e-6))
    # Map -50dB to 0dB into bar levels
    norm = max(0.0, min(1.0, (db + 50.0) / 50.0))
    filled = int(norm * width)
    
    # Waveform visualizer simulation from current RMS/Peak
    wave = []
    for i in range(width):
        dist = abs(i - (width // 2)) / (width // 2)
        h = max(0.0, norm * (1.0 - 0.4 * dist) + 0.1 * math.sin(time.time() * 15 + i))
        idx = min(len(BARS) - 1, max(0, int(h * (len(BARS) - 1))))
        wave.append(BARS[idx])
    
    wave_str = "".join(wave)
    return f"[{wave_str}] {db:5.1f} dB"

def cmd_record():
    print("\033[1;37m🎙️  Voxtype Voice Dictation CLI\033[0m")
    print("Press \033[1;32mSPACE\033[0m or \033[1;32mENTER\033[0m to toggle recording, or \033[1;31mCTRL+C\033[0m to exit.\n")
    
    # Start voxtype recording
    subprocess.run(["voxtype", "record", "start"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    
    sock = None
    if os.path.exists(SOCKET_PATH):
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.connect(SOCKET_PATH)
            sock.setblocking(False)
        except Exception:
            sock = None
            
    try:
        while True:
            state = get_state()
            rms = 0.0
            if sock:
                try:
                    data = sock.recv(1024)
                    if data:
                        # 16-bit PCM samples
                        samples = struct.unpack(f"{len(data)//2}h", data[:len(data) - (len(data)%2)])
                        if samples:
                            rms = math.sqrt(sum(s*s for s in samples) / len(samples)) / 32768.0
                except (BlockingIOError, socket.error):
                    pass
            
            if state == "recording":
                meter = render_meter(rms, rms)
                print(f"\r\033[1;31m● REC\033[0m  {meter}  \033[90m(Listening...)\033[0m  ", end="", flush=True)
            elif state == "transcribing":
                print(f"\r\033[1;33m⚙ TRANSCRIBING\033[0m  \033[90m[ Processing speech to text... ]\033[0m        ", end="", flush=True)
            else:
                print(f"\r\033[1;32m✔ IDLE\033[0m  \033[90m[ Standby - Press F9 or SUPER+CTRL+X to record ]\033[0m   ", end="", flush=True)
            time.sleep(0.04)
    except KeyboardInterrupt:
        print("\n\n\033[1;33mStopping...\033[0m")
        subprocess.run(["voxtype", "record", "stop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    finally:
        if sock:
            sock.close()

def cmd_monitor():
    print("\033[1;37m🔊  Voxtype Live Audio Level & Waveform Monitor\033[0m")
    print("Displays live voice volume and bouncing waveform indicator.\n")
    
    sock = None
    if os.path.exists(SOCKET_PATH):
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.connect(SOCKET_PATH)
            sock.setblocking(False)
        except Exception:
            pass
            
    try:
        while True:
            state = get_state()
            rms = 0.0
            if sock:
                try:
                    data = sock.recv(2048)
                    if data:
                        samples = struct.unpack(f"{len(data)//2}h", data[:len(data) - (len(data)%2)])
                        if samples:
                            rms = math.sqrt(sum(s*s for s in samples) / len(samples)) / 32768.0
                except (BlockingIOError, socket.error):
                    pass
            
            status_tag = f"\033[1;31m● REC\033[0m" if state == "recording" else f"\033[1;32m● {state.upper()}\033[0m"
            meter = render_meter(rms, rms, width=30)
            print(f"\r{status_tag} {meter}  ", end="", flush=True)
            time.sleep(0.03)
    except KeyboardInterrupt:
        print("\n")
    finally:
        if sock:
            sock.close()

if __name__ == "__main__":
    action = sys.argv[1] if len(sys.argv) > 1 else "monitor"
    if action == "record":
        cmd_record()
    elif action in ("monitor", "listen", "live"):
        cmd_monitor()
    elif action == "toggle":
        subprocess.run(["voxtype", "record", "toggle"])
    elif action == "start":
        subprocess.run(["voxtype", "record", "start"])
    elif action == "stop":
        subprocess.run(["voxtype", "record", "stop"])
    elif action == "cancel":
        subprocess.run(["voxtype", "record", "cancel"])
    else:
        print("Usage: voxtype-cli [monitor|record|start|stop|toggle|cancel]")
