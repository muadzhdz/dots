[%General]
author=matugen-auto
comment=Material You dark theme, auto-synced with matugen palette
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
no_active_tab_separator=false
mirror_doc_tabs=true
bold_active_tab=false
joined_inactive_tabs=true
group_toolbar_buttons=false
toolbar_interior_spacing=3
toolbar_item_spacing=1
toolbar_separator_thickness=6
spread_progressbar=true
spread_header=true
composite=true
menu_shadow_depth=6
menu_separator_height=5
tooltip_shadow_depth=6
scroll_width=8
scroll_arrows=false
scroll_min_extent=50
slider_width=4
slider_handle_width=18
slider_handle_length=16
tickless_slider_handle_size=18
center_toolbar_handle=true
check_size=16
textless_progressbar=false
progressbar_thickness=4
menubar_mouse_tracking=true
toolbutton_style=1
click_behavior=0
translucent_windows=true
reduce_window_opacity=25
blurring=false
popup_blurring=true
blur_translucent=true
vertical_spin_indicators=false
inline_spin_indicators=true
inline_spin_separator=true
spin_button_width=24
fill_rubberband=false
merge_menubar_with_toolbar=false
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=22
combo_as_lineedit=false
square_combo_button=false
layout_spacing=5
tooltip_delay=-1
submenu_overlap=0
animate_states=true
combo_menu=true
hide_combo_checkboxes=true
combo_focus_rect=true
groupbox_top_label=true
layout_margin=7
respect_DE=false
scrollbar_in_view=true
transient_scrollbar=true
transient_groove=true
tree_branch_line=true
no_window_pattern=false
reduce_menu_opacity=10
submenu_delay=250
no_inactiveness=false
rounding=8

[GeneralColors]
window.color={{colors.surface_dim.default.hex}}
inactive.window.color={{colors.surface_dim.default.hex}}
base.color={{colors.surface_container.default.hex}}
inactive.base.color={{colors.surface_container_low.default.hex}}
alt.base.color={{colors.surface_container_high.default.hex}}
inactive.alt.base.color={{colors.surface_container.default.hex}}
button.color={{colors.surface_container_high.default.hex}}
light.color={{colors.surface_container_highest.default.hex}}
mid.light.color={{colors.surface_container_high.default.hex}}
dark.color={{colors.surface_container_lowest.default.hex}}
mid.color={{colors.surface_container_low.default.hex}}
shadow.color=#000000
window.text.color={{colors.on_surface.default.hex}}
inactive.window.text.color={{colors.on_surface_variant.default.hex}}
base.text.color={{colors.on_surface.default.hex}}
inactive.base.text.color={{colors.on_surface_variant.default.hex}}
button.text.color={{colors.on_surface.default.hex}}
disabled.text.color={{colors.outline.default.hex}}
tooltip.base.color={{colors.surface_container_high.default.hex}}
tooltip.text.color={{colors.on_surface.default.hex}}
highlight.color={{colors.primary.default.hex}}
inactive.highlight.color={{colors.primary_container.default.hex}}
highlight.text.color={{colors.on_primary.default.hex}}
link.color={{colors.primary.default.hex}}
link.visited.color={{colors.tertiary.default.hex}}

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=true
blur_konsole=true
transparent_pcmanfm_sidepanel=false
opaque_colors_in_inactive_kde=false
